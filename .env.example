# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://sellora:sellora_dev_pass@localhost:5432/sellora_dev

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Must match exactly what you register in Google Cloud Console →
# APIs & Services → Credentials → OAuth 2.0 Client → Authorized redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

# After login, web users are redirected to FRONTEND_WEB_URL/auth/callback?access=...&refresh=...
FRONTEND_WEB_URL=http://localhost:5173

# After login, mobile/app users are redirected via deep link: sellora://auth/callback?access=...
# Change "sellora" to whatever scheme your app registers (e.g. "myapp")
APP_DEEP_LINK_SCHEME=sellora

# ─── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── File Storage (development uses local media/) ─────────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sellora <noreply@sellora.com>

# ─── Frontend URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
FRONTEND_WEB_URL=http://localhost:5173

# ─── Google OAuth redirect URI (must match Google Cloud Console exactly) ──────
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback/

# ─── Mobile app deep link scheme ──────────────────────────────────────────────
APP_DEEP_LINK_SCHEME=sellora

# ─── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=

# ─── WhatsApp Business Cloud API ──────────────────────────────────────────────
# Get these from Meta App Dashboard → Settings → Basic
WHATSAPP_APP_SECRET=
WHATSAPP_APP_ID=
