{
  "info": {
    "name": "Sellora API",
    "description": "Sellora backend API collection.\n\n## Setup\n1. Set the `baseUrl` variable to your server (default: `http://localhost:8000`).\n2. Complete Google SSO by opening `GET {{baseUrl}}/api/v1/auth/google/?next=web` in a browser — you can't do the redirect flow in Postman directly.\n3. Copy the `access` and `refresh` tokens from the redirect callback URL and paste them into the `accessToken` and `refreshToken` collection variables.\n4. All authenticated requests will pick up the Bearer token automatically.\n\n## Auth flow reminder\n- Open `{{baseUrl}}/api/v1/auth/google/?next=web` in a browser\n- Log in with Google\n- You land on `{FRONTEND_WEB_URL}/auth/callback?access=TOKEN&refresh=TOKEN`\n- Copy those tokens into the collection variables below",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Backend base URL. Change to your production URL when needed."
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string",
      "description": "JWT access token. Paste here after completing Google SSO in a browser."
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string",
      "description": "JWT refresh token. Used by the token refresh request."
    },
    {
      "key": "businessId",
      "value": "",
      "type": "string",
      "description": "UUID of the business you are working with. Set after creating or listing businesses."
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "Google OAuth initiation, token management, and user profile.",
      "item": [
        {
          "name": "Initiate Google SSO (web)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google/?next=web",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "google", ""],
              "query": [
                {
                  "key": "next",
                  "value": "web",
                  "description": "Origin: 'web' redirects to FRONTEND_WEB_URL after login"
                }
              ]
            },
            "description": "Opens the Google sign-in page.\n\nPostman will follow the redirect to Google — you cannot complete login inside Postman. Open this URL in a real browser instead.\n\nAfter login, Google redirects to /api/v1/auth/google/callback/ which then redirects you to:\n  {FRONTEND_WEB_URL}/auth/callback?access=TOKEN&refresh=TOKEN\n\nCopy those tokens into the `accessToken` and `refreshToken` collection variables."
          }
        },
        {
          "name": "Initiate Google SSO (app)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google/?next=app",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "google", ""],
              "query": [
                {
                  "key": "next",
                  "value": "app",
                  "description": "Origin: 'app' redirects to APP_DEEP_LINK_SCHEME://auth/callback after login"
                }
              ]
            },
            "description": "Same as the web flow but after login the backend redirects to the mobile deep link:\n  sellora://auth/callback?access=TOKEN&refresh=TOKEN\n\nOpen in a browser on a device that has the app installed to test the deep link."
          }
        },
        {
          "name": "Google OAuth Callback (reference only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google/callback/?code=GOOGLE_CODE&state=web",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "google", "callback", ""],
              "query": [
                {
                  "key": "code",
                  "value": "GOOGLE_CODE",
                  "description": "One-time authorization code from Google. You cannot generate this manually."
                },
                {
                  "key": "state",
                  "value": "web",
                  "description": "Passed through from the initiation step. 'web' or 'app'."
                }
              ]
            },
            "description": "This endpoint is called automatically by Google after the user signs in. You never call it manually.\n\nIncluded here for documentation purposes only — to show what Google sends back and what parameters it carries."
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me", ""]
            },
            "description": "Returns the profile of the currently authenticated user.\n\nRequires: Bearer token in Authorization header (set via collection variable).\n\nResponse:\n{\n  \"success\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"email\": \"user@gmail.com\",\n    \"name\": \"John Doe\",\n    \"avatar\": \"https://...\",\n    \"is_staff\": false,\n    \"created_at\": \"2026-09-12T...\"\n  }\n}"
          }
        },
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) {",
                  "    pm.collectionVariables.set('accessToken', json.access);",
                  "    console.log('Access token refreshed and saved to collection variable.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token/refresh/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "token", "refresh", ""]
            },
            "description": "Exchange a refresh token for a new access token.\n\nNo Authorization header needed — uses the refresh token in the body.\n\nThe test script automatically saves the new access token to the `accessToken` collection variable.\n\nNote: with ROTATE_REFRESH_TOKENS=True, a new refresh token is also returned. Update `refreshToken` manually if you want to keep it current."
          }
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/signout/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "signout", ""]
            },
            "description": "Blacklists the refresh token so it can no longer be used.\n\nThe access token will remain valid until it naturally expires (60 minutes by default). For immediate invalidation, reduce ACCESS_TOKEN_LIFETIME_MINUTES in your .env.\n\nResponse: 204 No Content"
          }
        }
      ]
    },
    {
      "name": "Businesses",
      "description": "Business management. Each user can own one or more businesses. All other resources are scoped under a business ID.",
      "item": [
        {
          "name": "List My Businesses",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.results && json.results.length > 0) {",
                  "    pm.collectionVariables.set('businessId', json.results[0].id);",
                  "    console.log('businessId set to: ' + json.results[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", ""]
            },
            "description": "List all businesses owned by the authenticated user.\n\nThe test script automatically sets `businessId` to the first result's ID."
          }
        },
        {
          "name": "Create Business",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maison Aura\",\n  \"category\": \"cosmetics\",\n  \"description\": \"Premium beauty and skincare products.\",\n  \"motto\": \"Beauty, redefined.\",\n  \"logo\": \"\",\n  \"contact\": {\n    \"phone\": \"+254712345678\",\n    \"whatsapp\": \"+254712345678\",\n    \"email\": \"hello@maisonaura.com\",\n    \"address\": \"123 Moi Avenue\",\n    \"city\": \"Nairobi\",\n    \"country\": \"Kenya\",\n    \"openingHours\": \"Mon–Fri: 8am – 6pm\"\n  },\n  \"theme\": {\n    \"primaryColor\": \"#7C3AED\",\n    \"primaryHover\": \"#6D28D9\",\n    \"accentColor\": \"#F59E0B\",\n    \"backgroundColor\": \"#FFFFFF\",\n    \"textColor\": \"#111827\"\n  },\n  \"hero\": {\n    \"heading\": \"Welcome to Maison Aura\",\n    \"subheading\": \"Beauty, redefined.\",\n    \"ctaText\": \"Shop Now\",\n    \"ctaSecondaryText\": \"Learn More\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", ""]
            },
            "description": "Creates a new business (onboarding flow). Slug is auto-generated from the name. Plan defaults to 'starter'."
          }
        },
        {
          "name": "Get Business",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/{{businessId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", "{{businessId}}", ""]
            }
          }
        },
        {
          "name": "Update Business",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Store Name\",\n  \"description\": \"Updated description.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/{{businessId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", "{{businessId}}", ""]
            }
          }
        },
        {
          "name": "Delete Business",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/{{businessId}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", "{{businessId}}", ""]
            }
          }
        },
        {
          "name": "Get Business by Slug (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/by-slug/:slug/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", "by-slug", ":slug", ""],
              "variable": [
                {
                  "key": "slug",
                  "value": "my-store",
                  "description": "Business slug (URL-safe name, e.g. maison-aura)"
                }
              ]
            },
            "description": "Resolves a business slug to its full profile. Public — no auth required.\n\nUsed by the frontend to initialise the storefront context on page load."
          }
        },
        {
          "name": "Get Business Settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/{{businessId}}/settings/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", "{{businessId}}", "settings", ""]
            },
            "description": "Returns notification preferences and locale settings (currency, timezone, language)."
          }
        },
        {
          "name": "Update Business Settings",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email_on_new_order\": true,\n  \"email_on_low_stock\": true,\n  \"email_on_new_message\": true,\n  \"sms_on_new_order\": false,\n  \"currency\": \"KES\",\n  \"timezone\": \"Africa/Nairobi\",\n  \"language\": \"en\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/{{businessId}}/settings/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", "{{businessId}}", "settings", ""]
            },
            "description": "All fields are optional — only send the ones you want to change."
          }
        },
        {
          "name": "Get Storefront Settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/{{businessId}}/storefront/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", "{{businessId}}", "storefront", ""]
            },
            "description": "Returns storefront display configuration: featured products/categories, section toggles, publish state."
          }
        },
        {
          "name": "Save Storefront Settings",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"featured_product_ids\": [],\n  \"featured_category_ids\": [],\n  \"show_new_arrivals\": true,\n  \"show_best_sellers\": true,\n  \"show_testimonials\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/{{businessId}}/storefront/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", "{{businessId}}", "storefront", ""]
            },
            "description": "Saves storefront configuration changes without publishing.\n\nTo push changes live, call the Publish endpoint after saving."
          }
        },
        {
          "name": "Publish Storefront",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/{{businessId}}/storefront/publish/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", "{{businessId}}", "storefront", "publish", ""]
            },
            "description": "Makes the storefront publicly visible. Sets is_published=true and records last_published_at.\n\nBusiness must have status=active."
          }
        },
        {
          "name": "Unpublish Storefront",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/{{businessId}}/storefront/unpublish/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "businesses", "{{businessId}}", "storefront", "unpublish", ""]
            },
            "description": "Takes the storefront offline. Sets is_published=false."
          }
        }
      ]
    },
